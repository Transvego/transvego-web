---
import { Button } from "../ui/Button";
---

<section class="mt-40 md:mt-50 flex flex-col gap-16">
  <h2
    class="text-primary-transvego text-3xl md:text-5xl lg:text-[64px] font-medium mb-6 lg:mb-0"
  >
    Documentos de Interés
  </h2>
  <div class="flex flex-col gap-8 items-start">
    <p class="max-w-145 text-primary-transvego">
      Encuentra documentos importantes de consulta relacionados con la
      organización. Accede a información de interés, como reglamentos, políticas
      y otros recursos que pueden ser de utilidad.
    </p>
    <a
      href="https://drive.google.com/drive/folders/1DAm0Uuiz_rnJbU2CrOFOD0Z4r4Qu2JnC?usp=sharing"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Button small>Ver documentos</Button>
    </a>
  </div>
</section>  
