---
import Layout from "@/layouts/Layout.astro";
import { Wrapper } from "@/components/Wrapper";
import { Hero } from "@/components/sections/Hero";
import AboutUs from "@/components/sections/AboutUs.astro";
import { Services } from "@/components/sections/Services";
import Documents from "@/components/sections/Documents.astro";
import Allies from "@/components/sections/Allies.astro";
import { Ticker } from "@/components/Ticker";
import Clients from "@/components/sections/Clients.astro";
import ContactUs from "@/components/sections/ContactUs.astro";
---

<Layout>
  <Hero client:load />
  <main>
    <Wrapper>
      <AboutUs />
      <Services client:visible />
      <Documents />
      <Allies />
    </Wrapper>
    <Ticker client:visible />
    <Wrapper>
      <Clients />
      <ContactUs />
    </Wrapper>
  </main>
</Layout>
